<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#1a1a1a">
    <link rel="manifest" href="manifest.webmanifest">
    <link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
    <link rel="apple-touch-icon" href="icon-192.png">
    <title>ACGC</title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            background: #000;
            color: #ddd;
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                "Roboto",
                "Helvetica Neue",
                Arial,
                sans-serif;
            height: 100%;
            overflow: hidden;
        }
        #container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            width: 100%;
        }
        #canvas {
            display: block;
            background: #000;
            outline: none;
            image-rendering: pixelated;
            /* Display at the drawing buffer's aspect (we clamp it to ≤ 4:3 in JS),
               so narrow windows letterbox top/bottom against the black body bg. */
            width: 100vw;
            height: auto;
            max-height: 100vh;
        }
        #status {
            position: fixed;
            top: 8px;
            left: 8px;
            font-size: 12px;
            opacity: 0.7;
            pointer-events: none;
        }
        #build-tag {
            position: fixed;
            right: 8px;
            bottom: 8px;
            font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
            font-size: 11px;
            opacity: 0.45;
            pointer-events: none;
            user-select: none;
            z-index: 1;
        }
        #progress {
            position: fixed;
            bottom: 0;
            left: 0;
            height: 3px;
            background: #4a9;
            width: 0%;
            transition: width 0.2s;
        }
        #rom-picker {
            display: none;
            position: fixed;
            inset: 0;
            background: #000;
            color: #ddd;
            z-index: 10;
            padding: 32px 24px;
            box-sizing: border-box;
            overflow: auto;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            gap: 20px;
        }
        #rom-picker.visible { display: flex; }
        #rom-picker h1 {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
        }
        #rom-instructions {
            max-width: 600px;
            width: 100%;
            line-height: 1.5;
            font-size: 14px;
            opacity: 0.85;
            padding-left: 20px;
        }
        #rom-instructions li { margin: 6px 0; }
        #rom-drop {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            width: 100%;
            max-width: 600px;
            min-height: 180px;
            border: 2px dashed #4a9;
            border-radius: 12px;
            padding: 24px;
            cursor: pointer;
            transition: background 0.15s, border-color 0.15s;
            box-sizing: border-box;
        }
        #rom-drop:hover,
        #rom-drop.dragging {
            background: rgba(74,153,89,0.08);
            border-color: #6c0;
        }
        #rom-drop input { display: none; }
        #rom-drop .primary { font-size: 16px; margin-bottom: 4px; }
        #rom-drop .secondary { font-size: 12px; opacity: 0.65; }
        #rom-status {
            min-height: 1.4em;
            font-size: 13px;
            opacity: 0.85;
        }
        #rom-status.error { color: #f88; opacity: 1; }
    </style>
</head>
<body>
    <div id="container">
        <canvas id="canvas" oncontextmenu="event.preventDefault()" tabindex="-1"></canvas>
    </div>
    <div id="status">loading…</div>
    <div id="progress"></div>
    <div id="build-tag" title="Build identifier">@PC_WEB_BUILD_TAG@</div>

    <div id="rom-picker" aria-hidden="true">
        <h1>Slider – A Web Port of GC Animal Crossing</h1>
        <ol id="rom-instructions">
            <li>Although this is a port and not an emulator, no assets are distributed with here. A disc image file of AC is still necessary to play the game for this reason.</li>
            <li>Thank you to ACreTeam and flyngmt for their work on the decomp and PC port of ACGC, on which this project is built on top of.</li>
            <li>This software is provided as-is, without warranty of any kind. There's no guarantee it won't corrupt your save data at some point, so export your save data as often as necessary.</li>
        </ol>
        <label id="rom-drop" for="rom-file">
            <div class="primary">Drag a USA (GAFE01 Rev 0) disc image here, or click to select</div>
            <div class="secondary">.iso · .gcm · .ciso — stays on your device</div>
            <input id="rom-file" type="file" accept=".iso,.gcm,.ciso">
        </label>
        <div id="rom-status"></div>
    </div>

    <script type="text/javascript">
        var statusEl = document.getElementById('status');
        var progressEl = document.getElementById('progress');

        // Match the canvas's drawing-buffer size to the viewport, capped
        // at MAX_CANVAS_DIM per axis. The GameCube renders at 640×480
        // natively — anything beyond ~1920 is wasted upsampling. DPR is
        // intentionally ignored for the same reason. CSS stretches the
        // canvas to fill the viewport.
        var MAX_CANVAS_DIM = 1920;
        function resizeCanvasToViewport() {
            var c = document.getElementById('canvas');
            var w = window.innerWidth;
            var h = window.innerHeight;
            // Letterbox narrow windows: cap drawing-buffer aspect at 4:3 so
            // the engine never sees a taller-than-4:3 viewport. Wide windows
            // are left alone — the engine pillarboxes them itself.
            var maxH = Math.floor(w * 3 / 4);
            if (h > maxH) h = maxH;
            if (w > MAX_CANVAS_DIM || h > MAX_CANVAS_DIM) {
                var scale = Math.min(MAX_CANVAS_DIM / w, MAX_CANVAS_DIM / h);
                w = Math.floor(w * scale);
                h = Math.floor(h * scale);
            }
            c.width  = w;
            c.height = h;
        }
        resizeCanvasToViewport();
        window.addEventListener('resize', resizeCanvasToViewport);

        var Module = {
            canvas: (function() {
                var c = document.getElementById('canvas');
                c.addEventListener('webglcontextlost', function(e) {
                    alert('WebGL context lost. Please reload.');
                    e.preventDefault();
                }, false);
                return c;
            })(),
            setStatus: function(text) {
                if (!text) {
                    statusEl.style.display = 'none';
                    progressEl.style.width = '0%';
                    return;
                }
                statusEl.textContent = text;
                var m = text.match(/\((\d+(\.\d+)?)\/(\d+)\)/);
                if (m) {
                    var pct = parseFloat(m[1]) / parseFloat(m[3]) * 100;
                    progressEl.style.width = pct + '%';
                } else {
                    progressEl.style.width = '100%';
                }
            },
            print: function(text) { console.log(text); },
            printErr: function(text) { console.warn(text); },
            onRuntimeInitialized: function() {
                Module.setStatus('');
                document.getElementById('canvas').focus();
            }
        };

        window.onerror = function(msg) {
            Module.setStatus('error — check console');
            console.error(msg);
        };

        // ----- ROM upload picker -----
        // Shown by pc_web_prompt_for_rom() when the wasm side fails to find
        // a disc image in the IDBFS-backed /orig directory. The file is
        // validated (GameCube magic word at offset 0x1C), written to
        // /orig/user-rom.iso, and persisted via FS.syncfs(false).
        var pickerEl   = document.getElementById('rom-picker');
        var dropEl     = document.getElementById('rom-drop');
        var fileInput  = document.getElementById('rom-file');
        var statusBox  = document.getElementById('rom-status');

        function setRomStatus(msg, isError) {
            statusBox.textContent = msg || '';
            statusBox.className = isError ? 'error' : '';
        }

        function showRomPicker() {
            pickerEl.classList.add('visible');
            pickerEl.setAttribute('aria-hidden', 'false');
            setRomStatus('');
        }
        function hideRomPicker() {
            pickerEl.classList.remove('visible');
            pickerEl.setAttribute('aria-hidden', 'true');
        }
        // Expose to wasm via Module global lookup
        window.showRomPicker = showRomPicker;

        // GC disc magic word lives at offset 0x1C, big-endian 0xC2339F3D.
        function isValidGCImage(buf) {
            if (buf.byteLength < 0x20) return false;
            var bytes = new Uint8Array(buf, 0x1C, 4);
            return bytes[0] === 0xC2 && bytes[1] === 0x33 &&
                   bytes[2] === 0x9F && bytes[3] === 0x3D;
        }

        // The port is built against GAFE01 Rev 0 (Animal Crossing, USA,
        // original revision). Other regions (GAFP/GAFJ) and revisions
        // have different asset offsets/symbol layout and will crash
        // shortly after boot, so reject them up-front.
        //   bytes 0x00..0x05 = game code "GAFE01" (ASCII)
        //   byte  0x07       = revision (0x00 for Rev 0)
        var SUPPORTED_GAME_ID  = 'GAFE01';
        var SUPPORTED_REVISION = 0x00;
        function readGameId(buf) {
            var bytes = new Uint8Array(buf, 0x00, 6);
            var s = '';
            for (var i = 0; i < 6; i++) s += String.fromCharCode(bytes[i]);
            return s;
        }
        function readRevision(buf) {
            return new Uint8Array(buf, 0x07, 1)[0];
        }
        function describeUnsupported(buf) {
            var id  = readGameId(buf);
            var rev = readRevision(buf);
            return 'Unsupported version: ' + id + ' Rev ' + rev +
                   '. This port supports ' + SUPPORTED_GAME_ID +
                   ' Rev ' + SUPPORTED_REVISION + ' (Animal Crossing, USA) only.';
        }
        function isSupportedVersion(buf) {
            return readGameId(buf) === SUPPORTED_GAME_ID &&
                   readRevision(buf) === SUPPORTED_REVISION;
        }

        function readFileAsArrayBuffer(file) {
            return new Promise(function(resolve, reject) {
                var reader = new FileReader();
                reader.onload  = function() { resolve(reader.result); };
                reader.onerror = function() { reject(reader.error); };
                reader.readAsArrayBuffer(file);
            });
        }

        function handleSelectedFile(file) {
            if (!file) return;
            setRomStatus('Reading file…');
            readFileAsArrayBuffer(file).then(function(buf) {
                setRomStatus('Validating…');
                if (!isValidGCImage(buf)) {
                    setRomStatus(
                        'That file isn’t a recognized GameCube disc image. ' +
                        'Expected an ACGC .iso/.gcm/.ciso. Please try again.',
                        true);
                    return;
                }
                if (!isSupportedVersion(buf)) {
                    setRomStatus(describeUnsupported(buf), true);
                    return;
                }
                try {
                    FS.writeFile('/orig/user-rom.iso', new Uint8Array(buf));
                } catch (e) {
                    setRomStatus('Write failed: ' + (e && e.message || e), true);
                    console.error('[rom] FS.writeFile failed', e);
                    return;
                }
                setRomStatus('Saving to browser storage…');
                FS.syncfs(false, function(err) {
                    if (err) {
                        setRomStatus('Persist failed: ' + err, true);
                        console.error('[rom] FS.syncfs failed', err);
                        return;
                    }
                    setRomStatus('Loading…');
                    Module.__rom_uploaded = 1;
                    hideRomPicker();
                });
            }).catch(function(err) {
                setRomStatus('Read failed: ' + (err && err.message || err), true);
                console.error('[rom] FileReader failed', err);
            });
        }

        fileInput.addEventListener('change', function(ev) {
            handleSelectedFile(ev.target.files && ev.target.files[0]);
            ev.target.value = ''; /* allow re-selecting the same file after an error */
        });

        // Drag-and-drop on the dashed zone
        ['dragenter', 'dragover'].forEach(function(t) {
            dropEl.addEventListener(t, function(ev) {
                ev.preventDefault();
                ev.stopPropagation();
                dropEl.classList.add('dragging');
            });
        });
        ['dragleave', 'drop'].forEach(function(t) {
            dropEl.addEventListener(t, function(ev) {
                ev.preventDefault();
                ev.stopPropagation();
                dropEl.classList.remove('dragging');
            });
        });
        dropEl.addEventListener('drop', function(ev) {
            var f = ev.dataTransfer && ev.dataTransfer.files && ev.dataTransfer.files[0];
            handleSelectedFile(f);
        });

        // Catch drops anywhere else on the page so the browser doesn't
        // navigate away when the user misses the drop zone.
        ['dragover', 'drop'].forEach(function(t) {
            document.addEventListener(t, function(ev) {
                if (pickerEl.classList.contains('visible')) ev.preventDefault();
            });
        });

        // Register the service worker on page load so the wasm bundle is
        // cached for offline use after the first visit. Requires HTTPS (or
        // localhost). Failure is non-fatal — the app still works online.
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('sw.js').catch(function(err) {
                    console.warn('[pwa] service worker registration failed:', err);
                });
            });
        }
        // Ask the browser not to evict our IndexedDB (saves + future ROM
        // storage) under storage pressure. Best-effort; users can still
        // decline. No-op on browsers that don't support it.
        if (navigator.storage && navigator.storage.persist) {
            navigator.storage.persist().catch(function() { /* ignore */ });
        }

        // Prompt before the user closes the tab / navigates away so an
        // accidental close doesn't lose unsaved progress. The dialog text
        // is browser-controlled (modern browsers ignore custom messages
        // and show a generic "Leave site?" prompt) — what matters is
        // returning a non-empty string, which is the API's signal to
        // show the confirm dialog at all.
        //
        // Only armed once the runtime is up AND the ROM picker is hidden —
        // i.e. the user is actually playing. Otherwise (loading screen,
        // ROM upload prompt) the page closes cleanly without a confirm.
        var _runtimeReady = false;
        var _origOnRuntimeInitialized = Module.onRuntimeInitialized;
        Module.onRuntimeInitialized = function() {
            if (typeof _origOnRuntimeInitialized === 'function') {
                _origOnRuntimeInitialized();
            }
            _runtimeReady = true;
        };
        window.addEventListener('beforeunload', function(e) {
            if (!_runtimeReady) return;
            if (pickerEl.classList.contains('visible')) return;
            e.preventDefault();
            e.returnValue = ''; // required by some browsers to trigger the dialog
            return '';
        });

        // The Web Audio graph keeps replaying its last buffer when the
        // wasm runtime is frozen (e.g. by the modal beforeunload prompt),
        // producing a loud buzz. AudioContext.suspend() is async and
        // doesn't take effect before the modal blocks JS, so we silence
        // synchronously by disconnecting SDL's output node on beforeunload.
        function getAudioContext() {
            try { return Module && Module.SDL2 && Module.SDL2.audioContext; }
            catch (e) { return null; }
        }
        function getAudioOutputNode() {
            try {
                var a = Module && Module.SDL2 && Module.SDL2.audio;
                if (!a) return null;
                return a.scriptProcessorNode || a.audioWorkletNode || null;
            } catch (e) { return null; }
        }
        function suspendAudio() {
            var ctx = getAudioContext();
            if (ctx && ctx.state === 'running') ctx.suspend().catch(function() {});
        }
        function resumeAudio() {
            var ctx = getAudioContext();
            if (ctx && ctx.state === 'suspended') ctx.resume().catch(function() {});
        }
        // Suspend only on genuine backgrounding (other tab, minimized
        // browser). Window blur (alt-tab to another app, DevTools focus)
        // leaves the tab visible — keep audio playing like YouTube/Spotify.
        document.addEventListener('visibilitychange', function() {
            if (document.hidden) suspendAudio(); else resumeAudio();
        });
        // Track the disconnected node so we can reconnect it if the user
        // cancels the close-confirm dialog (SDL won't rebuild the graph
        // on its own).
        var _disconnectedAudioNode = null;
        function reconnectAudio() {
            var ctx = getAudioContext();
            if (_disconnectedAudioNode && ctx) {
                try { _disconnectedAudioNode.connect(ctx.destination); } catch (e) {}
                _disconnectedAudioNode = null;
            }
            resumeAudio();
        }
        window.addEventListener('beforeunload', function() {
            // Synchronous: disconnect the SDL output node so the audio
            // graph stops feeding samples to the destination immediately,
            // before the close-confirm modal freezes the wasm thread.
            var node = getAudioOutputNode();
            if (node) {
                try { node.disconnect(); _disconnectedAudioNode = node; } catch (e) {}
            }
            suspendAudio();
        });
        // If the user cancels the close dialog, the page regains focus —
        // reconnect the audio node we synchronously disconnected above.
        window.addEventListener('focus', reconnectAudio);

        // ----- Save export -----
        // Reads GCI saves out of the IDBFS-backed /save tree and triggers
        // browser downloads. Exposed as window.exportSave(slot?) so a UI
        // element can be wired up later. `slot`:
        //   'a'  → only Card A's primary GCI (DobutsunomoriP_MURA.gci)
        //   'b'  → every .gci found in /save/card_b/ (Card B is BYO town;
        //          filename is whatever the user dropped in)
        //   omit → both A and B (default)
        // Returns the count of files that were downloaded (0 if nothing).
        var CARD_A_DIR        = '/save/card_a';
        var CARD_B_DIR        = '/save/card_b';
        var CARD_A_GCI        = 'DobutsunomoriP_MURA.gci';
        function _exportTimestamp() {
            var pad2 = function(n) { return ('0' + n).slice(-2); };
            var d = new Date();
            return d.getFullYear() + pad2(d.getMonth() + 1) + pad2(d.getDate()) +
                   '-' + pad2(d.getHours()) + pad2(d.getMinutes());
        }
        function _downloadBytes(bytes, fileName) {
            var blob = new Blob([bytes], { type: 'application/octet-stream' });
            var url  = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(function() { URL.revokeObjectURL(url); }, 1000);
        }
        function _exportOneFile(path, baseName, stamp) {
            var bytes;
            try {
                bytes = FS.readFile(path);
            } catch (e) {
                return false;
            }
            var stampedName = baseName.replace(/\.gci$/i, '') + '-' + stamp + '.gci';
            _downloadBytes(bytes, stampedName);
            console.log('[save-export] downloaded', stampedName,
                        '(' + bytes.length + ' bytes from ' + path + ')');
            return true;
        }
        function _listGcisIn(dir) {
            try {
                return FS.readdir(dir).filter(function(n) {
                    return /\.gci$/i.test(n) && n !== '.' && n !== '..';
                });
            } catch (e) {
                return [];
            }
        }
        function exportSave(slot) {
            if (typeof FS === 'undefined') {
                console.warn('[save-export] FS not ready');
                return 0;
            }
            // Best-effort flush MEMFS → IDBFS; the read below uses MEMFS
            // either way, so this is just for durability.
            try { FS.syncfs(false, function() {}); } catch (e) {}
            var stamp = _exportTimestamp();
            var count = 0;
            if (slot === undefined || slot === 'a') {
                if (_exportOneFile(CARD_A_DIR + '/' + CARD_A_GCI, CARD_A_GCI, stamp)) count++;
                else if (slot === 'a') console.warn('[save-export] no save at', CARD_A_DIR + '/' + CARD_A_GCI);
            }
            if (slot === undefined || slot === 'b') {
                var bGcis = _listGcisIn(CARD_B_DIR);
                bGcis.forEach(function(name) {
                    if (_exportOneFile(CARD_B_DIR + '/' + name, name, stamp)) count++;
                });
                if (slot === 'b' && bGcis.length === 0) {
                    console.warn('[save-export] no .gci files in', CARD_B_DIR);
                }
            }
            if (count === 0 && slot === undefined) {
                console.warn('[save-export] no save data found in either slot');
            }
            return count;
        }
        window.exportSave = exportSave;

        // ----- Save import -----
        // Writes a GCI into the IDBFS-backed /save tree. Symmetric to
        // exportSave; intended to be wired to a UI element later.
        //   slot: 'a' (overwrites the canonical Card A save) or 'b'
        //         (drops the file into card_b/ for visiting)
        //   src : File / Blob / ArrayBuffer / Uint8Array
        // Returns a Promise that resolves to true on success, false on
        // validation/IO failure. Validation: GCI header gameName must
        // be "GAFE" (USA AC); for slot 'a' the embedded fileName must
        // additionally be "DobutsunomoriP_MURA" so a rogue Card B GCI
        // can't clobber the real save.
        function _toUint8Array(src) {
            return new Promise(function(resolve, reject) {
                if (src instanceof Uint8Array) { resolve(src); return; }
                if (src instanceof ArrayBuffer) { resolve(new Uint8Array(src)); return; }
                if (src && typeof src.arrayBuffer === 'function') {
                    src.arrayBuffer().then(function(ab) { resolve(new Uint8Array(ab)); }, reject);
                    return;
                }
                reject(new Error('importSave: unsupported source (need File/Blob/ArrayBuffer/Uint8Array)'));
            });
        }
        function _readGciFileName(bytes) {
            if (bytes.length < 0x28) return '';
            var name = '';
            for (var i = 0x08; i < 0x28; i++) {
                var c = bytes[i];
                if (c === 0) break;
                name += String.fromCharCode(c);
            }
            return name;
        }
        function _validateGciHeader(bytes) {
            if (bytes.length < 0x40) return 'file too small to be a GCI (need ≥64 bytes)';
            // gameName "GAFE" (USA AC); other regions wouldn't run anyway
            // since the port is built for GAFE01 Rev 0.
            if (bytes[0] !== 0x47 /* G */ || bytes[1] !== 0x41 /* A */ ||
                bytes[2] !== 0x46 /* F */ || bytes[3] !== 0x45 /* E */) {
                return 'not a USA Animal Crossing GCI (gameName ≠ "GAFE")';
            }
            return null;
        }
        function importSave(slot, src) {
            return _toUint8Array(src).then(function(bytes) {
                if (typeof FS === 'undefined') {
                    console.warn('[save-import] FS not ready');
                    return false;
                }
                var headerErr = _validateGciHeader(bytes);
                if (headerErr) {
                    console.warn('[save-import]', headerErr);
                    return false;
                }
                var embeddedName = _readGciFileName(bytes);
                var path;
                if (slot === 'a') {
                    if (embeddedName !== 'DobutsunomoriP_MURA') {
                        console.warn('[save-import] Card A requires DobutsunomoriP_MURA, got "' +
                                     embeddedName + '"');
                        return false;
                    }
                    try { FS.mkdir(CARD_A_DIR); } catch (e) { /* exists */ }
                    path = CARD_A_DIR + '/' + CARD_A_GCI;
                } else if (slot === 'b') {
                    if (!embeddedName) {
                        console.warn('[save-import] GCI has empty embedded filename');
                        return false;
                    }
                    try { FS.mkdir(CARD_B_DIR); } catch (e) { /* exists */ }
                    path = CARD_B_DIR + '/' + embeddedName + '.gci';
                } else {
                    console.warn('[save-import] slot must be "a" or "b"');
                    return false;
                }
                try {
                    FS.writeFile(path, bytes);
                } catch (e) {
                    console.warn('[save-import] write failed:', e && e.message);
                    return false;
                }
                // Persist to IndexedDB so the import survives reload.
                return new Promise(function(resolve) {
                    FS.syncfs(false, function(err) {
                        if (err) {
                            console.warn('[save-import] syncfs failed:', err);
                            resolve(false);
                            return;
                        }
                        console.log('[save-import] wrote', path,
                                    '(' + bytes.length + ' bytes)');
                        resolve(true);
                    });
                });
            }).catch(function(err) {
                console.warn('[save-import]', err && err.message);
                return false;
            });
        }
        window.importSave = importSave;
    </script>
    {{{ SCRIPT }}}
</body>
</html>
